#!/usr/bin/env bash
set -euo pipefail

incoming=/tmp/cute-mafia-api.new
target=/usr/local/bin/cute-mafia-api
previous=/usr/local/bin/cute-mafia-api.previous

test -f "$incoming"
install -o root -g root -m 0755 "$incoming" "$target.next"
if [[ -f "$target" ]]; then
  cp -a "$target" "$previous"
fi
mv -f "$target.next" "$target"
rm -f "$incoming"
systemctl restart cute-mafia-api

for _ in {1..15}; do
  if curl --fail --silent --max-time 2 http://127.0.0.1:8000/api/health >/dev/null; then
    exit 0
  fi
  sleep 1
done

if [[ -f "$previous" ]]; then
  install -o root -g root -m 0755 "$previous" "$target"
  systemctl restart cute-mafia-api
fi
echo "Health check failed; previous binary restored" >&2
exit 1
